# =============================================================================
# Arquivo de exemplo de variaveis de ambiente - Autocenter Billing Service
# Copie para .env (ignorado pelo git) e preencha com suas credenciais de teste
# =============================================================================

# Modo de operacao do Mercado Pago: 'real' (chama API oficial) ou 'stub' (para testes locais sem credenciais)
MERCADOPAGO_MODO=real

# URL base da API do Mercado Pago
MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# Credenciais de Teste da sua aplicacao no painel do Mercado Pago Developers
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-aqui

# URL publica para receber Webhooks do Mercado Pago.
# Se deixado em branco, o servico busca automaticamente o tunel HTTPS ativo no ngrok local (http://localhost:4040/api/tunnels).
MERCADOPAGO_NOTIFICATION_URL=

# Endpoint da API local do ngrok
NGROK_API_URL=http://localhost:4040/api/tunnels

# URLs de retorno do Checkout Pro apos o pagamento
MERCADOPAGO_BACK_URL_SUCCESS=https://httpbin.org/get?back_url=success
MERCADOPAGO_BACK_URL_FAILURE=https://httpbin.org/get?back_url=failure
MERCADOPAGO_BACK_URL_PENDING=https://httpbin.org/get?back_url=pending

# Conexao com o Banco de Dados MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/billing?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=billing
SPRING_DATASOURCE_PASSWORD=billing

# Broker Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

